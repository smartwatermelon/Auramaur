<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.auramaur.gluetun</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/andrewrich/Library/Application Support/auramaur/scripts/wrapper-gluetun.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/andrewrich/Library/Application Support/auramaur</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Unconditional KeepAlive: the wrapper is a long-running supervisor
       that should never exit. If it does, restart immediately. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/andrewrich/Library/Logs/auramaur/gluetun.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/andrewrich/Library/Logs/auramaur/gluetun.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/andrewrich/.local/bin</string>
    <key>HOME</key>
    <string>/Users/andrewrich</string>
  </dict>

  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
